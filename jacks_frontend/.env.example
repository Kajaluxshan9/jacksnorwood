# Jack's Norwood - Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# Vite exposes variables prefixed with VITE_ to the browser.

# Backend API base URL
# Local:      http://localhost:8080/api
# Production: https://api.jacksnorwoodpub.ca/api
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Restaurant Info ─────────────────────────────────────────
VITE_RESTAURANT_NAME=Jack's Norwood
VITE_RESTAURANT_PHONE=your_phone_number
VITE_RESTAURANT_EMAIL=your_email@example.com
VITE_RESTAURANT_ADDRESS=your_restaurant_address

# Online ordering provider link (used by the navbar and footer)
VITE_ONLINE_ORDER_URL=

# ─── Opening Hours ───────────────────────────────────────────
# Two groupings are supported. Pick ONE - do not mix them.
#
# A) Two bands (what production uses, and the default if nothing is set):
VITE_HOURS_SUN_WED=08:00 AM - 08:00 PM
VITE_HOURS_THU_SAT=08:00 AM - 10:00 PM
#
# B) Three bands, if the week splits differently:
# VITE_HOURS_MON_THU=11:00 AM - 10:00 PM
# VITE_HOURS_FRI_SAT=11:00 AM - 12:00 AM
# VITE_HOURS_SUN=12:00 PM - 09:00 PM
#
# If both are set, the two-band names win. Set any variable to an empty
# value to hide that row. These feed the footer, contact page, reservation
# sidebar, home page AND the structured data Google reads - so a wrong value
# here shows customers the wrong opening hours in search results too.

# ─── Google Maps ─────────────────────────────────────────────
# How to get it: Google Maps -> search your location -> Share -> "Embed a map"
# -> copy only the src="..." URL value.
# If left empty, a map is generated from VITE_RESTAURANT_ADDRESS instead.
VITE_GOOGLE_MAPS_EMBED_URL=

# ─── Hero section background image URL ───────────────────────
# Only used when no hero images have been uploaded in the admin panel.
# Accepts an absolute URL, or an uploaded path such as /uploads/abc123.jpeg
# (backend-relative paths are resolved against the API host automatically).
VITE_HERO_IMAGE_URL=
