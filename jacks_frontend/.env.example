# Jack's Norwood - Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# Vite exposes variables prefixed with VITE_ to the browser.

# Backend API base URL
# Local:      http://localhost:8080/api
# Production: https://api.jacksnorwoodpub.ca/api
VITE_API_BASE_URL=http://localhost:8080/api

# ─── Restaurant Info ─────────────────────────────────────────
VITE_RESTAURANT_NAME=Jack's Norwood
VITE_RESTAURANT_PHONE=your_phone_number
VITE_RESTAURANT_EMAIL=your_email@example.com
VITE_RESTAURANT_ADDRESS=your_restaurant_address

# ─── Opening Hours ───────────────────────────────────────────
VITE_HOURS_SUN_WED=08:00 AM - 08:00 PM
VITE_HOURS_THU_SAT=08:00 AM - 10:00 AM

# ─── Google Maps ─────────────────────────────────────────────
# How to get it: Google Maps -> search your location -> Share -> "Embed a map" -> copy only the src="..." URL value
VITE_GOOGLE_MAPS_EMBED_URL=

# ─── Hero section background image URL ───────────────────────
# Leave empty to use the default bundled image
# To use an uploaded image, set to its /uploads/... path, e.g:
#   VITE_HERO_IMAGE_URL=/uploads/abc123.jpeg
VITE_HERO_IMAGE_URL=
