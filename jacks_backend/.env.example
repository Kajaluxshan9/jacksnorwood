# Jack's Norwood - Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── Spring Profile ──────────────────────────────────────────
# Use 'dev' locally (seeds sample data on first boot)
# Use 'prod' in production (skips DataInitializer)
SPRING_PROFILES_ACTIVE=prod

# ─── Server ─────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Database (REQUIRED) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jacksnorwood
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ─── Admin Seed Credentials (REQUIRED) ─────────────────────
# These are used on first boot to create the admin user.
# Change immediately after first login in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── JWT (REQUIRED — generate a strong random 256-bit key) ──
# Example: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_KEY_AT_LEAST_256_BITS
JWT_EXPIRATION=86400000

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Mail (REQUIRED for any email to be sent) ───────────────
# The account the site sends FROM: subscriber welcomes, booking confirmations,
# newsletters, and the alerts below.
#
# Left as placeholders, the site still runs and nothing reports an error to
# users - every email just fails quietly in the log. Production ran like that
# for months, so check the backend log for "Authentication failed" after setup.
#
# For Gmail, MAIL_PASSWORD must be a 16-character App Password
# (myaccount.google.com/apppasswords), not the normal account password.
# Enter it without spaces.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ─── Restaurant ──────────────────────────────────────────────
# Inbox that receives every contact-form message (with CVs attached) and every
# new booking request. Must be a mailbox someone actually reads - production
# pointed this at an unused address and customer messages went unseen.
# It can be the same address as MAIL_USERNAME.
RESTAURANT_EMAIL=your_restaurant_email@example.com

# ─── File Upload ─────────────────────────────────────────────
# Where uploaded images and CVs are stored on disk.
#
# Use an ABSOLUTE path in production. A relative path is resolved against
# whatever directory the process was started from, so if that ever changes,
# files already referenced by the database become unreachable and every image
# silently falls back to a placeholder.
#
#   Local:      uploads
#   Production: /var/lib/jacksnorwood/uploads
#
# The directory must survive deployments - do not put it inside the release
# folder, and back it up alongside the database.
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB

# ─── Logging ────────────────────────────────────────────────
# Options: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
